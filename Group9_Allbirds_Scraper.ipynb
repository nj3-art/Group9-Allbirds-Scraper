    "def check_robots():\n",
    "    r = requests.get(BASE + \"/robots.txt\", headers=HEADERS, timeout=30)\n",
    "    print(r.status_code); print(r.text[:2000])\n",
    "    rp = urllib.robotparser.RobotFileParser(); rp.parse(r.text.splitlines())\n",
    "    ok = rp.can_fetch(HEADERS[\"User-Agent\"], FEED)\n",
    "    print(\"Allowed to fetch products.json:\", ok)\n",
    "    return ok\n",
    "\n",
    "if not check_robots():\n",
    "    raise SystemExit(\"robots.txt disallows the feed - stop and document it.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Scraper (pagination, retries with back-off, polite delays)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "n_requests = 0\n",
    "\n",
    "def get_json(url, params=None, retries=4):\n",
    "    global n_requests\n",
    "    for attempt in range(retries):\n",
    "        if n_requests >= MAX_REQUESTS:\n",
    "            raise RuntimeError(\"Daily request cap reached\")\n",
    "        try:\n",
    "            n_requests += 1\n",
    "            r = requests.get(url, headers=HEADERS, params=params, timeout=30)\n",
    "            if r.status_code in (403, 429):      # blocked / rate-limited: do NOT bypass\n",
    "                wait = 60 * (attempt + 1)\n",
    "                print(f\"HTTP {r.status_code} - backing off {wait}s (document this)\")\n",
    "                time.sleep(wait); continue\n",
    "            r.raise_for_status()\n",
    "            return r.json()\n",
    "        except (requests.RequestException, ValueError) as e:\n",
    "            wait = 2 ** attempt * 5\n",
    "            print(f\"Attempt {attempt+1} failed: {e}; retry in {wait}s\")\n",
    "            time.sleep(wait)\n",
    "    return None\n",
    "\n",
    "def scrape_all():\n",
    "    products, page = [], 1\n",
    "    while True:\n",
    "        data = get_json(FEED, {\"limit\": PAGE_SIZE, \"page\": page})\n",
    "        if data is None:\n",
    "            print(\"Giving up on page\", page); break\n",
    "        items = data.get(\"products\", [])\n",
    "        if not items: break\n",
    "        products.extend(items)\n",
    "        print(f\"page {page}: {len(items)} products (total {len(products)})\")\n",
    "        if len(items) < PAGE_SIZE: break\n",
    "        page += 1\n",
    "        time.sleep(random.uniform(*DELAY))\n",
    "    return products"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Flatten to one row per variant (handles missing fields)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "def flatten(products, scraped_at):\n",
    "    rows = []\n",
    "    for p in products:\n",
    "        tags = p.get(\"tags\") or []\n",
    "        if isinstance(tags, str): tags = [t.strip() for t in tags.split(\",\") if t.strip()]\n",
    "        opt_names = [o.get(\"name\") for o in (p.get(\"options\") or [])]\n",
    "        for v in (p.get(\"variants\") or [{}]):\n",
    "            size = None\n",
    "            for i, name in enumerate(opt_names, 1):\n",
    "                if name and re.search(r\"size\", name, re.I):\n",
    "                    size = v.get(f\"option{i}\")\n",
    "            rows.append({\n",
    "                \"product_id\": p.get(\"id\"), \"handle\": p.get(\"handle\"),\n",
    "                \"title\": p.get(\"title\"), \"vendor\": p.get(\"vendor\"),\n",
    "                \"product_type\": p.get(\"product_type\") or \"Unknown\",\n",
    "                \"tags\": \"|\".join(tags),\n",
    "                \"variant_id\": v.get(\"id\"), \"variant_title\": v.get(\"title\"),\n",
    "                \"size\": size, \"sku\": v.get(\"sku\"),\n",
    "                \"price\": v.get(\"price\"), \"compare_at_price\": v.get(\"compare_at_price\"),\n",
    "                \"available\": v.get(\"available\"),\n",
    "                \"scraped_at\": scraped_at,\n",
    "            })\n",
    "    return rows\n",
    "\n",
    "def run_scrape():\n",
    "    ts = datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n",
    "    day = ts[:10]\n",
    "    products = scrape_all()\n",
    "    (RAW_DIR / f\"allbirds_raw_{day}.json\").write_text(json.dumps(products))   # unchanged evidence\n",
    "    df = pd.DataFrame(flatten(products, ts))\n",
    "    df.to_csv(RAW_DIR / f\"allbirds_flat_{day}.csv\", index=False)\n",
    "    print(f\"{len(products)} products, {len(df)} variant rows, {n_requests} requests\")\n",
    "    return df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Cleaning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "def clean(df):\n",
    "    d = df.copy()\n",
    "    for c in (\"price\", \"compare_at_price\"):\n",
    "        d[c] = pd.to_numeric(d[c].astype(str).str.replace(r\"[^0-9.]\", \"\", regex=True), errors=\"coerce\")\n", #prices to numeric
    "    d[\"discount_pct\"] = ((d.compare_at_price - d.price) / d.compare_at_price * 100).where(d.compare_at_price > d.price).round(1)\n", #dicount
    "    d[\"on_sale\"] = d.discount_pct.notna()\n",
    "    d[\"product_type\"] = d.product_type.str.strip().str.title().replace(\"\", \"Unknown\")\n",
    "    d[\"size\"] = d[\"size\"].astype(str).str.strip().replace({\"None\": None, \"nan\": None})\n",
    "    d[\"available\"] = d[\"available\"].astype(\"boolean\")\n",
    "    d[\"scraped_at\"] = pd.to_datetime(d.scraped_at)\n",
    "    d[\"scrape_date\"] = d.scraped_at.dt.date.astype(str)\n",
    "    d = d.drop_duplicates(subset=[\"variant_id\", \"scrape_date\"])\n",
    "    return d.dropna(subset=[\"product_id\", \"variant_id\", \"price\"])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. SQLite storage – `products` (1 row/product), `variants` (1 row/variant), `observations` (price & stock per variant per day)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "SCHEMA = '''\n",
    "CREATE TABLE IF NOT EXISTS products(\n",
    "  product_id INTEGER PRIMARY KEY, handle TEXT, title TEXT, vendor TEXT,\n",
    "  product_type TEXT, tags TEXT);\n",
    "CREATE TABLE IF NOT EXISTS variants(\n",
    "  variant_id INTEGER PRIMARY KEY, product_id INTEGER REFERENCES products(product_id),\n",
    "  variant_title TEXT, size TEXT, sku TEXT);\n",
    "CREATE TABLE IF NOT EXISTS observations(\n",
    "  variant_id INTEGER REFERENCES variants(variant_id), scrape_date TEXT, scraped_at TEXT,\n",
    "  price REAL, compare_at_price REAL, discount_pct REAL, available INTEGER,\n",
    "  PRIMARY KEY(variant_id, scrape_date));\n",
    "'''\n",
    "def load(d, db=DB_PATH):\n",
    "    con = sqlite3.connect(db); con.executescript(SCHEMA)\n",
    "    p = d[[\"product_id\",\"handle\",\"title\",\"vendor\",\"product_type\",\"tags\"]].drop_duplicates(\"product_id\")\n",
    "    v = d[[\"variant_id\",\"product_id\",\"variant_title\",\"size\",\"sku\"]].drop_duplicates(\"variant_id\")\n",
    "    o = d[[\"variant_id\",\"scrape_date\",\"scraped_at\",\"price\",\"compare_at_price\",\"discount_pct\",\"available\"]].copy()\n",
    "    o[\"scraped_at\"] = o.scraped_at.astype(str); o[\"available\"] = o.available.astype(\"float\").astype(\"Int64\")\n",
    "    for name, df_, cols in ((\"products\", p, \"product_id\"), (\"variants\", v, \"variant_id\")):\n",
    "        df_.to_sql(\"_tmp\", con, if_exists=\"replace\", index=False)\n",
    "        con.execute(f\"INSERT OR REPLACE INTO {name}({','.join(df_.columns)}) SELECT * FROM _tmp\")\n",
    "    o.to_sql(\"_tmp\", con, if_exists=\"replace\", index=False)\n",
    "    con.execute(\"INSERT OR REPLACE INTO observations SELECT * FROM _tmp\")\n",
    "    con.execute(\"DROP TABLE _tmp\"); con.commit(); con.close()"
   ]
  },
