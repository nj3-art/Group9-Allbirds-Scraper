    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 1. Load all daily CSV files\n",
    "files = sorted(Path(\"raw\").glob(\"allbirds_flat_*.csv\"))\n",
    "\n",
    "if not files:\n",
    "    raise FileNotFoundError(\"No daily CSV files found in the raw folder.\")\n",
    "\n",
    "data = pd.concat([pd.read_csv(f) for f in files], ignore_index=True) #reads each file, stacks them into 1 table, ignore_index renumbers file 0...n \n",
    "\n",
    "# Make availability values consistent\n",
    "data[\"available\"] = data[\"available\"].astype(str).str.lower().map(\n",
    "    {\"true\": True, \"false\": False, \"1\": True, \"0\": False}\n",
    ")\n",
    "\n",
    "# Clean and prepare the data\n",
    "df_all = clean(data)\n",
    "df_all[\"day\"] = pd.to_datetime(\n",
    "    df_all[\"scraped_at\"], utc=True, errors=\"coerce\"\n",
    ").dt.strftime(\"%Y-%m-%d\")\n",
    "\n",
    "# One record per product per day\n",
    "p = (df_all.groupby([\"day\", \"product_id\"], as_index=False)\n",
    "     .agg(title=(\"title\", \"first\"),\n",
    "          category=(\"product_type\", \"first\"),\n",
    "          price=(\"price\", \"median\"),\n",
    "          old_price=(\"compare_at_price\", \"median\"),\n",
    "          available=(\"available\", \"max\")))\n",
    "\n",
    "p[\"category\"] = p[\"category\"].fillna(\"Unknown\").replace(\"\", \"Unknown\")\n",
    "p[\"discount\"] = (\n",
    "    (p[\"old_price\"] - p[\"price\"]) / p[\"old_price\"] * 100\n",
    ").where(p[\"old_price\"] > p[\"price\"])\n",
    "\n",
    "p[\"on_sale\"] = p[\"old_price\"] > p[\"price\"]\n",
    "\n",
    "days = sorted(p[\"day\"].dropna().unique())\n",
    "latest = p[p[\"day\"] == days[-1]]\n",
    "\n",
    "print(\"CSV files found:\", len(files))\n",
    "print(\"Distinct scrape dates:\", days)\n",
    "\n",
    "if len(days) < 2:\n",
    "    print(\"Note: Collect data on more dates to compare trends over time.\")\n",
    "\n",
    "# CHART 1: Price distribution by product type\n",
    "latest.boxplot(column=\"price\", by=\"category\", rot=35, figsize=(10, 4))\n",
    "plt.suptitle(\"\")\n",
    "plt.title(\"1. Price Distribution by Product Type\")\n",
    "plt.xlabel(\"Product type\")\n",
    "plt.ylabel(\"Price\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "medians = latest.groupby(\"category\")[\"price\"].median().dropna()\n",
    "if not medians.empty:\n",
    "    print(f\"Interpretation: {medians.idxmax()} has the highest median price \"\n",
    "          f\"({medians.max():.2f}), while {medians.idxmin()} has the lowest \"\n",
    "          f\"({medians.min():.2f}). Points beyond the whiskers may be outliers.\")\n",
    "\n",
    "# CHART 2: Average price across days\n",
    "daily_price = p.groupby(\"day\")[\"price\"].mean()\n",
    "daily_price.plot(marker=\"o\", figsize=(8, 4),\n",
    "                 title=\"2. Average Price Across Scrape Days\")\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Average price\")\n",
    "plt.grid(axis=\"y\", alpha=0.3)\n",
    "plt.xticks(rotation=35)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "if len(daily_price) >= 2:\n",
    "    change = daily_price.iloc[-1] - daily_price.iloc[0]\n",
    "    print(f\"Interpretation: Average price changed by {change:+.2f} \"\n",
    "          f\"between {days[0]} and {days[-1]}.\")\n",
    "else:\n",
    "    print(\"Interpretation: One date is not enough to identify a price trend.\")\n",
    "\n",
    "# CHART 3: Average prices by category across days\n",
    "category_price = p.groupby([\"day\", \"category\"])[\"price\"].mean().unstack()\n",
    "category_price.plot(marker=\"o\", figsize=(9, 4),\n",
    "                    title=\"3. Category Prices Across Scrape Days\")\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Average price\")\n",
    "plt.grid(axis=\"y\", alpha=0.3)\n",
    "plt.xticks(rotation=35)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "if len(days) >= 2:\n",
    "    common = category_price.columns[\n",
    "        category_price.iloc[0].notna() & category_price.iloc[-1].notna()\n",
    "    ]\n",
    "    changes = category_price[common].iloc[-1] - category_price[common].iloc[0]\n",
    "    if not changes.empty:\n",
    "        category = changes.abs().idxmax()\n",
    "        print(f\"Interpretation: {category} had the largest absolute change \"\n",
    "              f\"in average price ({changes[category]:+.2f}).\")\n",
    "    else:\n",
    "        print(\"Interpretation: No category has prices on both dates.\")\n",
    "else:\n",
    "    print(\"Interpretation: More dates are needed to compare category trends.\")\n",
    "\n",
    "# CHART 4: Products with the biggest price changes\n",
    "if len(days) >= 2:\n",
    "    wide = p.pivot_table(index=[\"product_id\", \"title\"],\n",
    "                         columns=\"day\", values=\"price\", aggfunc=\"median\")\n",
    "\n",
    "    changes = wide[[days[0], days[-1]]].dropna().copy()\n",
    "    changes[\"change\"] = changes[days[-1]] - changes[days[0]]\n",
    "\n",
    "    if not changes.empty:\n",
    "        top = changes.loc[changes[\"change\"].abs().nlargest(10).index].copy()\n",
    "        top[\"product\"] = [f\"{title} (ID {pid})\" for pid, title in top.index]\n",
    "        top.set_index(\"product\")[\"change\"].sort_values().plot(\n",
    "            kind=\"barh\", figsize=(9, 5),\n",
    "            title=\"4. Largest Product Price Changes\"\n",
    "        )\n",
    "        plt.xlabel(\"Price change\")\n",
    "        plt.ylabel(\"Product\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "        biggest = changes[\"change\"].abs().idxmax()\n",
    "        print(f\"Interpretation: {biggest[1]} had the largest price change \"\n",
    "              f\"({changes.loc[biggest, 'change']:+.2f}).\")\n",
    "    else:\n",
    "        print(\"Interpretation: No products have prices on both dates.\")\n",
    "else:\n",
    "    print(\"Chart 4 needs at least two scrape dates.\")\n",
    "\n",
    "# CHART 5: Percentage of products discounted\n",
    "sale_share = p.groupby(\"day\")[\"on_sale\"].mean() * 100\n",
    "sale_share.plot(kind=\"bar\", figsize=(8, 4),\n",
    "                title=\"5. Percentage of Products Discounted\")\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Discounted products (%)\")\n",
    "plt.xticks(rotation=35)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "if len(sale_share) >= 2:\n",
    "    print(f\"Interpretation: The discounted share changed by \"\n",
    "          f\"{sale_share.iloc[-1] - sale_share.iloc[0]:+.1f} percentage points.\")\n",
    "else:\n",
    "    print(f\"Interpretation: {sale_share.iloc[-1]:.1f}% of products \"\n",
    "          f\"were discounted on the recorded date.\")\n",
    "\n",
    "# CHART 6: Average discount size\n",
    "discounts = p[p[\"on_sale\"]].groupby(\"day\")[\"discount\"].mean().dropna()\n",
    "\n",
    "if not discounts.empty:\n",
    "    discounts.plot(kind=\"bar\", figsize=(8, 4),\n",
    "                   title=\"6. Average Discount Size Across Scrape Days\")\n",
    "    plt.xlabel(\"Date\")\n",
    "    plt.ylabel(\"Average discount (%)\")\n",
    "    plt.xticks(rotation=35)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    if len(discounts) >= 2:\n",
    "        print(f\"Interpretation: Average discount size changed by \"\n",
    "              f\"{discounts.iloc[-1] - discounts.iloc[0]:+.1f} \"\n",
    "              f\"percentage points between dates with valid discounts.\")\n",
    "    else:\n",
    "        print(f\"Interpretation: Average discount size was \"\n",
    "              f\"{discounts.iloc[0]:.1f}% on the recorded date.\")\n",
    "else:\n",
    "    print(\"Chart 6: No valid discounts were found.\")\n",
    "\n",
    "# CHART 7: Product availability across days\n",
    "availability = p.groupby(\"day\")[\"available\"].mean() * 100\n",
    "availability = availability.dropna()\n",
    "\n",
    "if not availability.empty:\n",
    "    availability.plot(marker=\"o\", figsize=(8, 4),\n",
    "                      title=\"7. Product Availability Across Scrape Days\")\n",
    "    plt.xlabel(\"Date\")\n",
    "    plt.ylabel(\"Products with an available variant (%)\")\n",
    "    plt.grid(axis=\"y\", alpha=0.3)\n",
    "    plt.xticks(rotation=35)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    if len(availability) >= 2:\n",
    "        print(f\"Interpretation: Availability changed by \"\n",
    "              f\"{availability.iloc[-1] - availability.iloc[0]:+.1f} \"\n",
    "              f\"percentage points.\")\n",
    "    else:\n",
    "        print(f\"Interpretation: {availability.iloc[0]:.1f}% of products \"\n",
    "              f\"had at least one available variant on this date.\")\n",
    "\n",
    "# CHART 8: Number of products by category\n",
    "counts = latest.groupby(\"category\")[\"product_id\"].nunique().sort_values()\n",
    "\n",
    "counts.plot(kind=\"barh\", figsize=(8, 4),\n",
    "            title=\"8. Unique Products by Category\")\n",
    "plt.xlabel(\"Number of products\")\n",
    "plt.ylabel(\"Product type\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "if not counts.empty:\n",
    "    print(f\"Interpretation: {counts.idxmax()} had the most products \"\n",
    "          f\"({counts.max()}), while {counts.idxmin()} had the fewest \"\n",
    "          f\"({counts.min()}).\")"
   ]
  }
